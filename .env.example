# Billionaire Speedrun — browser-safe configuration
#
# This app is frontend-only. It has no backend, no accounts, no payments and
# no external API. There are NO secrets to configure — never put passwords,
# API keys or tokens in this file or in any VITE_* variable, because every
# VITE_* value is compiled into the public JavaScript bundle.

# Path the app is served from.
#   "/"            -> own domain or subdomain root (default)
#   "/speedrun/"   -> served from a sub-folder behind a reverse proxy
VITE_BASE_PATH=/
